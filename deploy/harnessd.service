[Unit]
Description=harnessd - ACP v2 gateway for local coding agents
Documentation=https://github.com/coxlong/harness-acp
ConditionUser=!root

[Service]
Type=simple
ExecStart=%h/.local/bin/harnessd
Environment=HARNESSD_LISTEN=127.0.0.1:7800
Environment="PATH=%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%E/harnessd/settings.env
EnvironmentFile=%E/harnessd/token.env
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=default.target
