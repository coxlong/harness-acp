[Unit]
Description=harnessd - ACP v2 gateway for local coding agents
Documentation=https://github.com/coxlong/harness-acp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/harnessd
Environment=HARNESSD_LISTEN=127.0.0.1:7800
# Environment=HARNESSD_TOKEN=change-me
Restart=on-failure
RestartSec=2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
